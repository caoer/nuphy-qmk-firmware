# Custom rules for caoer keymap
# Enable VIA support (same as default)
VIA_ENABLE = yes

# Enable custom RGB modes (required for NuPhy position_mode, etc.)
RGB_MATRIX_CUSTOM_USER = yes

# Enable features we use
TAP_DANCE_ENABLE = yes   # F5 tap/hold for SuperWhisper
COMBO_ENABLE = no        # Not using combos (yet)
KEY_OVERRIDE_ENABLE = yes  # Ctrl+HJKL → arrow keys
